# The Gitea helper resolves the Rust image to a registry digest before build.
ARG RUST_BASE_IMAGE
FROM ${RUST_BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential clang mold cmake ninja-build pkg-config libssl-dev \
      libjack-jackd2-dev libasound2-dev \
      libx11-dev libx11-xcb-dev libxcursor-dev libxrandr-dev libxi-dev libxinerama-dev \
      libxkbcommon-dev libwayland-dev libglib2.0-dev libgtk-3-dev \
      libfontconfig1-dev libfreetype6-dev && \
    rm -rf /var/lib/apt/lists/*
