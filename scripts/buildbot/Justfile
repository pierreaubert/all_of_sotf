set shell := ["bash", "-c"]

# Buildbot 4.1 pins Twisted 23, which is incompatible with Python 3.13+
# because it still imports the removed stdlib `cgi` module.
host_python := env_var_or_default("HOST_PYTHON", "python3.12")
venv := "venv"
python := venv + "/bin/python3"
buildbot := venv + "/bin/buildbot"
worker := venv + "/bin/buildbot-worker"

# Show available recipes.
default:
	@just --list

# Create the Python virtualenv and install Buildbot packages.
install:
	#!/usr/bin/env bash
	set -euo pipefail
	"{{host_python}}" -c 'import sys; assert (3, 9) <= sys.version_info[:2] < (3, 13), "Buildbot requires Python 3.9-3.12"'
	if ! "{{python}}" -c 'import sys; assert (3, 9) <= sys.version_info[:2] < (3, 13); assert sys.prefix.endswith("/scripts/buildbot/venv")' >/dev/null 2>&1 \
		|| ! "{{buildbot}}" --version >/dev/null 2>&1; then
		echo "Rebuilding missing or relocated Buildbot virtualenv..."
		{{host_python}} -m venv --clear {{venv}}
	fi
	"{{python}}" -m pip install -r requirements.txt

# Copy the canonical master config into the live master directory.
sync-config:
	mkdir -p master
	cp master.cfg master/master.cfg
	cp ci_matrix.py master/ci_matrix.py

# Create the Buildbot master directory and install the canonical config.
master: sync-config
	#!/usr/bin/env bash
	set -euo pipefail
	{{buildbot}} create-master --force master
	if [ -f master/buildbot.tac.new ]; then
		mv master/buildbot.tac.new master/buildbot.tac
	fi
	just sync-config
	{{buildbot}} upgrade-master master

# Create the macOS local worker.
worker:
	#!/usr/bin/env bash
	set -euo pipefail
	{{worker}} create-worker --force worker-macos localhost macos-local macos-password
	if [ -f worker-macos/buildbot.tac.new ]; then
		mv worker-macos/buildbot.tac.new worker-macos/buildbot.tac
	fi

# Start the master and the macOS worker.
start: master worker
	#!/usr/bin/env bash
	set -euo pipefail
	{{buildbot}} start master
	echo "Waiting for master HTTP port to be ready..."
	ready=0
	for i in {1..10}; do
		if curl -sf http://localhost:8010 >/dev/null 2>&1; then
			echo "Master HTTP port ready."
			ready=1
			break
		fi
		sleep 1
	done
	if [ "$ready" -ne 1 ]; then
		echo "Master HTTP port did not become ready in time." >&2
		exit 1
	fi
	echo "Waiting for master PB port to be ready..."
	pb_ready=0
	for i in {1..10}; do
		if nc -z localhost 9989 >/dev/null 2>&1; then
			echo "Master PB port ready."
			pb_ready=1
			break
		fi
		sleep 1
	done
	if [ "$pb_ready" -ne 1 ]; then
		echo "Master PB port did not become ready in time." >&2
		exit 1
	fi
	{{worker}} start worker-macos

# Stop the master and the macOS worker.
stop:
	{{worker}} stop worker-macos || true
	{{buildbot}} stop master || true

# Validate the Buildbot configuration.
check: sync-config
	{{buildbot}} checkconfig master/master.cfg

# Run Buildbot configuration regression tests.
test-config:
	"{{python}}" -m unittest discover -s tests -v

# Validate both the Python tests and Buildbot's own configuration loader.
validate: test-config check

# Tail the master log.
logs-master:
	tail -f master/twistd.log

# Tail the worker log.
logs-worker:
	tail -f worker-macos/twistd.log

# Stop and start everything.
restart: stop start

# Rebuild the Linux Docker latent worker image.
rebuild-linux:
	docker build --platform linux/amd64 -t sotf/buildbot-linux-worker:v4.1.0 docker/linux-worker

# Rebuild the Linux image without cached layers.
rebuild-linux-clean:
	docker build --platform linux/amd64 --no-cache -t sotf/buildbot-linux-worker:v4.1.0 docker/linux-worker
